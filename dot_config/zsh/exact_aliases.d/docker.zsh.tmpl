# ------------------------------------------
# .aliases/docker 
# ------------------------------------------

# --- env ---

# determine docker root folder (shared or default)
if [[ -d "/opt/docker/compose" ]]; then
  DOCKER_ROOT="/opt/docker"
else
  _dh=("$HOME"/[Dd]ocker(N/))
  DOCKER_ROOT="${_dh[1]:-$HOME/docker}/compose"
fi

# Edit docker secrets / env files safely. Files end up root:root 0600 — we
# copy out to a user-owned tempfile, run $EDITOR, then atomically replace the
# original via a same-dir sibling rename. Replaces the old dp777/dp600 toggle
# (which left files world-writable while editing). macOS doesn't ship the
# `sudoedit` binary, so this implements the same pattern by hand.
#
# Usage:
#   dpedit .env                     → $DOCKER_ROOT/.env
#   dpedit secrets/foo              → $DOCKER_ROOT/secrets/foo
#   dpedit compose/<stack>/.env     → $DOCKER_ROOT/compose/<stack>/.env
#   dpedit /abs/path                → /abs/path (passthrough)
dpedit() {
  if (( $# == 0 )); then
    echo "usage: dpedit <path...>  (relative to \$DOCKER_ROOT, or absolute)" >&2
    return 2
  fi
  local rc=0 src tmp sibling pre post
  for arg in "$@"; do
    [[ "$arg" == /* ]] && src="$arg" || src="${DOCKER_ROOT}/${arg}"
    if ! sudo test -e "$src"; then
      echo "dpedit: $src: not found" >&2
      rc=1
      continue
    fi
    tmp=$(mktemp "${TMPDIR:-/tmp}/dpedit.XXXXXX") || { rc=1; continue; }
    if ! sudo cat "$src" > "$tmp"; then
      rm -f "$tmp"; rc=1; continue
    fi
    pre=$(shasum "$tmp" | awk '{print $1}')
    "${EDITOR:-vi}" "$tmp"
    post=$(shasum "$tmp" | awk '{print $1}')
    if [[ "$pre" == "$post" ]]; then
      echo "dpedit: $src unchanged"
    else
      # write to a same-dir sibling, fix perms, then atomic rename into place
      sibling="${src}.dpedit.$$"
      if sudo cp "$tmp" "$sibling" \
          && sudo chown root:root "$sibling" \
          && sudo chmod 600 "$sibling" \
          && sudo mv "$sibling" "$src"; then
        echo "dpedit: $src updated (root:root 0600)"
      else
        sudo rm -f "$sibling"
        echo "dpedit: write-back failed; tempfile preserved at $tmp" >&2
        rc=1
        continue
      fi
    fi
    rm -f "$tmp"
  done
  return $rc
}


# --- functions ---

# run compose commands from current working directory first, then from docker folder root anywhere else
get_compose_dir() {
    local cwd="$PWD"
    local docker_root="${DOCKER_ROOT:-$HOME/docker}"
    if ls "$cwd"/compose.yml >/dev/null 2>&1 || ls "$cwd"/compose.*.yml >/dev/null 2>&1; then
        echo "$cwd"
    else
        echo "$docker_root"
    fi
}

# Run a Compose command with Infisical values selected by a Stack profile.
# Universal Auth credentials must already be present in the current session as
# INFISICAL_UNIVERSAL_AUTH_CLIENT_ID and INFISICAL_UNIVERSAL_AUTH_CLIENT_SECRET.
infisical_compose() {
    if (( $# < 2 )); then
        echo "usage: infisical_compose <stack> <compose-args...>" >&2
        return 2
    fi

    local stack="$1"
    shift

    local compose_dir profile_file compose_file default_env stack_env
    compose_dir="$(get_compose_dir)"
    profile_file="$compose_dir/infisical/$stack/.infisical.json"
    if [[ "$stack" == "default" ]]; then
        compose_file="$compose_dir/compose.yml"
    else
        compose_file="$compose_dir/compose.$stack.yml"
    fi
    default_env="$compose_dir/.env"
    stack_env="$compose_dir/.env-$stack"

    if [[ ! -f "$profile_file" ]]; then
        echo "infisical_compose: profile not found: $profile_file" >&2
        return 1
    fi
    if [[ ! -f "$compose_file" ]]; then
        echo "infisical_compose: compose file not found: $compose_file" >&2
        return 1
    fi
    if [[ -z "${INFISICAL_UNIVERSAL_AUTH_CLIENT_ID:-}" || -z "${INFISICAL_UNIVERSAL_AUTH_CLIENT_SECRET:-}" ]]; then
        echo "infisical_compose: load the Infisical Universal Auth credentials into the current session" >&2
        return 1
    fi

    local profile_output
    if ! profile_output="$(python3 - "$profile_file" <<'PY'
import json
import sys

try:
    with open(sys.argv[1], encoding="utf-8") as profile_file:
        profile = json.load(profile_file)
    project_id = profile["workspaceId"]
    environment = profile["defaultEnvironment"]
    secret_path = profile["defaultSecretPath"]
    managed_keys = profile["managedKeys"]
    if not all(isinstance(value, str) and value for value in (project_id, environment, secret_path)):
        raise ValueError("project, environment, and path must be nonempty strings")
    if not managed_keys or not all(isinstance(key, str) and key for key in managed_keys):
        raise ValueError("managedKeys must be a nonempty string array")
except (OSError, KeyError, TypeError, ValueError, json.JSONDecodeError) as error:
    raise SystemExit(f"infisical_compose: invalid profile: {error}")

print(project_id)
print(environment)
print(secret_path)
print(",".join(managed_keys))
PY
)"; then
        return 1
    fi

    local -a profile_fields compose_args
    profile_fields=("${(@f)profile_output}")
    if (( ${#profile_fields[@]} != 4 )); then
        echo "infisical_compose: invalid profile output" >&2
        return 1
    fi

    local project_id="${profile_fields[1]}"
    local environment="${profile_fields[2]}"
    local secret_path="${profile_fields[3]}"
    local managed_keys="${profile_fields[4]}"
    local token

    compose_args=()
    [[ -f "$default_env" ]] && compose_args+=(--env-file "$default_env")
    [[ -f "$stack_env" ]] && compose_args+=(--env-file "$stack_env")
    compose_args+=(-f "$compose_file")

    token="$(infisical login \
        --domain=https://infisical.lab.brendans.cloud \
        --method=universal-auth \
        --silent \
        --plain)" || return 1
    if [[ -z "$token" ]]; then
        echo "infisical_compose: Infisical login returned an empty token" >&2
        return 1
    fi

    env \
        -u INFISICAL_UNIVERSAL_AUTH_CLIENT_ID \
        -u INFISICAL_UNIVERSAL_AUTH_CLIENT_SECRET \
        infisical run \
        --domain=https://infisical.lab.brendans.cloud \
        --token="$token" \
        --projectId="$project_id" \
        --env="$environment" \
        --path="$secret_path" \
        -- sudo --preserve-env="$managed_keys" \
        docker compose "${compose_args[@]}" "$@"
    local rc=$?
    unset token
    return $rc
}


# --- containers ---

alias dstart='sudo docker start' # usage: dstart container_name
alias dstop='sudo docker stop' # usage: dstop container_name
alias dstopall='sudo docker stop $(sudo docker ps -aq)' # stop all containers
alias drestart='sudo docker restart' # usage: drestart container_name
alias drestartall='sudo docker restart $(sudo docker ps -aq)' # restart all containers
alias drm='sudo docker rm' # usage: drm container_name
alias drmall='sudo docker rm $(sudo docker ps -aq)' # remove all containers
alias dexec='sudo docker exec -ti' # usage: dexec container_name


# --- compose / stacks ---

alias dc='sudo docker compose -f "$(get_compose_dir)/compose.yml"'
alias dcup='dc up -d --build'
alias dcdown='dc down'
alias dcstart='dc start'
alias dcstop='dc stop'
alias dcrec='dc up -d --force-recreate'
alias dcrestart='dc restart'
alias dcpull='dc pull'

alias idc='infisical_compose default'
alias idcup='idc up -d --build'
alias idcdown='idc down'
alias idcstart='idc start'
alias idcstop='idc stop'
alias idcrec='idc up -d --force-recreate'
alias idcrestart='idc restart'
alias idcpull='idc pull'

# dynamic stack-specific compose aliases

setopt +o nomatch 2>/dev/null
compose_dir="$(get_compose_dir)"
for file in "$compose_dir"/compose.*.yml; do
    [[ -e "$file" ]] || continue
    stack=$(basename "$file" | sed -E 's/compose\.(.*)\.yml/\1/')
    env_args=""

    default_env="$compose_dir/.env"
    stack_env="$compose_dir/.env-$stack"

    if [[ -f "$default_env" ]]; then
        env_args+=" --env-file $default_env"
    fi
    if [[ -f "$stack_env" ]]; then
        env_args+=" --env-file $stack_env"
    fi

    cmd_prefix="sudo docker compose$env_args -f $file"

    alias "dcup.$stack"="$cmd_prefix up -d --build"
    alias "dcdown.$stack"="$cmd_prefix down"
    alias "dcstart.$stack"="$cmd_prefix start"
    alias "dcstop.$stack"="$cmd_prefix stop"
    alias "dcrec.$stack"="$cmd_prefix up -d --force-recreate"
    alias "dcrestart.$stack"="$cmd_prefix restart"
    alias "dcpull.$stack"="$cmd_prefix pull"

    if [[ -f "$compose_dir/infisical/$stack/.infisical.json" ]]; then
        alias "idc.$stack"="infisical_compose $stack"
        alias "idcup.$stack"="infisical_compose $stack up -d --build"
        alias "idcdown.$stack"="infisical_compose $stack down"
        alias "idcstart.$stack"="infisical_compose $stack start"
        alias "idcstop.$stack"="infisical_compose $stack stop"
        alias "idcrec.$stack"="infisical_compose $stack up -d --force-recreate"
        alias "idcrestart.$stack"="infisical_compose $stack restart"
        alias "idcpull.$stack"="infisical_compose $stack pull"
    fi
done


# --- system ---
alias dps='sudo docker ps -a'
alias dpsa='sudo docker ps -a --format "table {{ `{{` }}.Names{{ `}}` }}\t{{ `{{` }}.State{{ `}}` }}\t{{ `{{` }}.Status{{ `}}` }}\t{{ `{{` }}.Image{{ `}}` }}" | (sed -u 1q; sort)'
alias ddf='sudo docker system df'
alias ddelimages='sudo docker rmi $(sudo docker images -q)'
alias dprunesys='sudo docker system prune -a'


# --- images ---
alias dimg='sudo docker image ls'
alias dpruneimg='sudo docker image prune'


# --- volumes ---
alias dvol='sudo docker volume ls'
alias dprunevol='sudo docker volume prune'


# --- logs ---
alias dlogs='sudo docker logs -tf --tail="50" '
alias dlogsize='sudo du -ch $(sudo docker inspect --format={{ `{{` }}.LogPath{{ `}}` }} $(sudo docker ps -qa)) | sort -h'


# --- network ---
alias dnet='sudo docker network ls'
alias dips="sudo docker ps -q | xargs -n 1 sudo docker inspect -f '{{ `{{` }}.Name{{ `}}` }}%tab%{{ `{{` }}range .NetworkSettings.Networks{{ `}}` }}{{ `{{` }}.IPAddress{{ `}}` }}%tab%{{ `{{` }}end{{ `}}` }}' | sed 's#%tab%#\t#g' | sed 's#/##g' | sort | column -t -N NAME,IP\(s\) -o \$'\t'"
