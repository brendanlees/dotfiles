{{- $apps := (index .themes .theme).apps -}}
# Use Glow's matching built-in style when available; otherwise render from the
# active chezmoi palette instead of letting "auto" degrade piped output to plain text.
style: "{{ if eq $apps.glow "auto" }}{{ .chezmoi.homeDir }}/.config/glow/chezmoi.json{{ else }}{{ $apps.glow }}{{ end }}"
# mouse support (TUI-mode only)
mouse: true
# use pager to display markdown
pager: false
# word-wrap at width
width: 80
# show all files, including hidden and ignored.
all: false
# show line numbers (TUI-mode only)
showLineNumbers: false
