# managed by chezmoi - install missing global tools without upgrading them
$ErrorActionPreference = 'Stop'

# Process-only bootstrap token. Later commands use mise's credential_command.
{{ if and (hasKey . "github_token") .github_token -}}
if (-not $env:GITHUB_TOKEN) { $env:GITHUB_TOKEN = {{ .github_token | quote }} }
{{ end -}}

if (-not (Get-Command mise -ErrorAction SilentlyContinue)) {
    throw 'mise not on PATH'
}

Write-Host 'installing missing mise tools...'
mise --cd $HOME install
if ($LASTEXITCODE -ne 0) { throw "mise install failed ($LASTEXITCODE)" }

if (Get-Command bat -ErrorAction SilentlyContinue) {
    bat cache --build
    if ($LASTEXITCODE -ne 0) { throw "bat cache build failed ($LASTEXITCODE)" }
}
