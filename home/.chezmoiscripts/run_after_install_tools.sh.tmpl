{{- if ne .chezmoi.os "windows" -}}
#!/bin/bash
set -euo pipefail

# These files are sourced on shell startup.
ALIASES_DIR="${XDG_CONFIG_HOME:-$HOME/.config}/zsh/aliases.d"
if [[ -d "$ALIASES_DIR" ]]; then
  chmod 700 "$ALIASES_DIR"
fi

# Bootstrap authentication must be available before the first tool download.
# Later mise commands use the credential_command in the global configuration.
{{ if and (hasKey . "github_token") .github_token -}}
github_token={{ .github_token | quote }}
export GITHUB_TOKEN="${GITHUB_TOKEN:-$github_token}"
export GITHUB_API_TOKEN="${GITHUB_API_TOKEN:-$GITHUB_TOKEN}"
{{ end -}}

# Keep direct GitHub metadata separate from previously cached hosted responses.
export MISE_USE_VERSIONS_HOST=0
export MISE_CACHE_DIR="${XDG_CACHE_HOME:-$HOME/.cache}/mise-direct"

MISE="$HOME/.local/bin/mise"
if [[ ! -x "$MISE" ]]; then
  echo "mise not found at $MISE" >&2
  exit 1
fi

# Bare install fills missing configured tools without upgrading installed ones.
# Use HOME so applying from a project does not install its local dependencies.
echo "installing missing mise tools..."
"$MISE" --cd "$HOME" install

if command -v bat >/dev/null 2>&1; then
  bat cache --build
fi
{{- end -}}
