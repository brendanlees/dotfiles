#!/bin/bash
set -euo pipefail

# Host-local opt-in: obsidian_headless.enabled and vault_path in .chezmoidata/local.yml.
# Reload when the rendered launch agent changes, not on unrelated chezmoi applies.
# agent: {{ includeTemplate "Library/LaunchAgents/private_com.brendan.obsidian-headless.plist.tmpl" . | sha256sum }}
{{ if eq .chezmoi.os "darwin" -}}
label=com.brendan.obsidian-headless
domain="gui/$(id -u)"
plist="$HOME/Library/LaunchAgents/$label.plist"

if launchctl print "$domain/$label" >/dev/null 2>&1; then
  launchctl bootout "$domain/$label"
fi

{{ if and .personal (dig "obsidian_headless" "enabled" false .) -}}
vault='{{ dig "obsidian_headless" "vault_path" "" . | replace "'" "'\\''" }}'
mise="$HOME/.local/bin/mise"
[[ -n "$vault" && -d "$vault/.obsidian" ]] || { echo 'Configured Obsidian vault is missing' >&2; exit 1; }
"$mise" --cd "$HOME" exec -- ob sync-status --path "$vault" --json >/dev/null

# Do not start a second sync client for the same local vault.
"$mise" --cd "$HOME" exec -- node - "$vault/.obsidian/core-plugins.json" <<'JS'
const fs = require("node:fs");
const plugins = JSON.parse(fs.readFileSync(process.argv[2], "utf8"));
if (Array.isArray(plugins) ? plugins.includes("sync") : plugins.sync) {
  console.error("Disable desktop Obsidian Sync before starting headless Sync");
  process.exit(1);
}
JS

umask 077
mkdir -p "$HOME/Library/Logs/ObsidianHeadless"
chmod 700 "$HOME/Library/Logs/ObsidianHeadless"
launchctl bootstrap "$domain" "$plist"
{{ else -}}
# Removing the agent prevents it from returning at the next login. Keep all
# credentials, sync state, logs and vault contents when opting out.
rm -f "$plist"
{{ end -}}
{{ end -}}
