#!/bin/bash
set -euo pipefail

# Reload only when the service configuration changes.
# agent: {{ includeTemplate "Library/LaunchAgents/private_com.brendan.obsidian-headless.plist.tmpl" . | sha256sum }}
{{ if eq .chezmoi.os "darwin" -}}
label=com.brendan.obsidian-headless
domain="gui/$(id -u)"
plist="$HOME/Library/LaunchAgents/$label.plist"

if launchctl print "$domain/$label" >/dev/null 2>&1; then
  launchctl bootout "$domain/$label"
fi

{{ if and .personal (dig "obsidian_headless" "enabled" false .) -}}
vault='{{ dig "obsidian_headless" "vault_path" (joinPath .chezmoi.homeDir "Notes/Obsidian/PKM") . | replace "'" "'\\''" }}'
mise="$HOME/.local/bin/mise"
status=$("$mise" --cd "$HOME" exec -- ob sync-status --path "$vault" --json)

# Refuse to start alongside desktop Sync; a headless-only vault may lack this file.
"$mise" --cd "$HOME" exec -- node - "$vault" "$status" <<'JS'
const fs = require("node:fs");
const path = require("node:path");
const config = JSON.parse(process.argv[3]);
const file = path.join(process.argv[2], config.configDir || ".obsidian", "core-plugins.json");
if (!fs.existsSync(file)) process.exit(0);
const plugins = JSON.parse(fs.readFileSync(file, "utf8"));
if (Array.isArray(plugins) ? plugins.includes("sync") : plugins.sync) {
  console.error("Disable desktop Obsidian Sync before starting headless Sync");
  process.exit(1);
}
JS

umask 077
mkdir -p "$HOME/Library/Logs/ObsidianHeadless"
chmod 700 "$HOME/Library/Logs/ObsidianHeadless"
launchctl bootstrap "$domain" "$plist"
{{ else -}}
rm -f "$plist"
{{ end -}}
{{ end -}}
