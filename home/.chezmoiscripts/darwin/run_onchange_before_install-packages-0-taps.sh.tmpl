#!/bin/sh
# The role-scoped taps list is the approval list, including future tap updates.
# Do not bypass Homebrew trust checks or approve unrelated installed taps.
set -eu

{{- $taps := fromJson (includeTemplate ".chezmoitemplates/merge-by-role.tmpl" (list .taps .)) | uniq }}

{{- range $taps }}
brew trust --tap {{ . | quote }}
brew tap {{ . | quote }}
{{- end }}
