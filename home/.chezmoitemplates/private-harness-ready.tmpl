{{- /* Gate private fetches; local hooks can instead accept their existing checkout. */ -}}
{{- $manifest := and (hasKey . "ssh") (hasKey .ssh "bw_manifest_item") .ssh.bw_manifest_item -}}
{{- if not $manifest -}}
true
{{- else if not (stat (joinPath .chezmoi.homeDir ".ssh/config.d/personal.conf")) -}}
false
{{- else if eq .chezmoi.os "windows" -}}
true
{{- else -}}
{{- /* Externals render before apply installs helpers; use the current source copy. */ -}}
{{- $helper := joinPath .chezmoi.sourceDir "dot_local/bin/executable_cz-ssh-ready" -}}
{{- $python := lookPath "python3" -}}
{{- if or (not $python) (not (stat $helper)) -}}
false
{{- else -}}
{{- output "sh" "-c" "if HOME=\"$1\" \"$2\" \"$3\" \"$4\" >/dev/null 2>&1; then printf true; else printf false; fi" "cz-ssh-ready" .chezmoi.homeDir $python $helper "git@gitea.lab.brendans.cloud" -}}
{{- end -}}
{{- end -}}
