{{- /* Zsh plugins are managed by Zinit. */ -}}

{{- if ne .chezmoi.os "windows" }}
[".config/tmux/plugins/tpm"]
type = "git-repo"
url = "https://github.com/tmux-plugins/tpm"
refreshPeriod = "168h"
exclude = [
  "*/.editorconfig",
  "*/.gitattributes",
  "*/.github",
  "*/.gitignore",
  "*/*.md",
  "*/test/**",
  "*/tests/**",
  "*/spec/**",
  "*/docs/**",
  "*/bindings/**",
  "**/*.zwc",
]
{{- end }}

{{/* Pinned SketchyBar quota renderer; no build toolchain required. */}}
{{- if and (eq .chezmoi.os "darwin") .personal }}
{{- $arch := "arm64" }}
{{- $sha := "c46e6d6c4ef8c76655617c871fd3f8f2bc6ea64e6eac456ad74ed29449b0b668" }}
{{- if eq .chezmoi.arch "amd64" }}
{{- $arch = "x86_64" }}
{{- $sha = "843a3b4c05925563169de553290b1411f9122db2fc74c765de1821ae5a431a74" }}
{{- end }}
[".config/sketchybar/vendor/showy-quota"]
type = "archive"
url = "https://github.com/enieuwy/showy-quota/releases/download/v0.9.0/showy-quota-0.9.0-macos-{{ $arch }}.tar.gz"
checksum.sha256 = "{{ $sha }}"
stripComponents = 1
exact = true
{{- end }}

{{/* fonts */}}

{{- if and .personal (not .headless) (or (eq .chezmoi.os "darwin") (eq .chezmoi.os "linux")) }}
{{-   $fontDir := "" }}
{{-   if eq .chezmoi.os "darwin" }}
{{-     $fontDir = "Library/Fonts" }}
{{-   else if eq .chezmoi.os "linux" }}
{{-     $fontDir = ".local/share/fonts" }}
{{-   end }}

["{{ $fontDir }}/{{ .nerd_font }}"]
type = "archive"
url = "https://github.com/ryanoasis/nerd-fonts/releases/latest/download/{{ .nerd_font }}.tar.xz"
exact = true
refreshPeriod = "168h"
include = ["{{ .nerd_font }}NerdFontMono-*.ttf"]
{{- end }}

{{/* nvim config */}}

{{- if not .ephemeral }}
{{- $nvimPath := ".config/nvim" }}
{{- if eq .chezmoi.os "windows" }}{{ $nvimPath = "AppData/Local/nvim" }}{{ end }}
["{{ $nvimPath }}"]
type = "archive"
url = "https://github.com/brendanlees/astronvim-config/archive/main.tar.gz"
stripComponents = 1
refreshPeriod = "168h"
exclude = [
  "*/.editorconfig",
  "*/.gitattributes",
  "*/.github",
  "*/.gitignore",
  "*/*.md",
  "*/test/**",
  "*/tests/**",
  "*/spec/**",
  "**/*.zwc",
  "**/lazy-lock.json",
]
{{- end }}


{{/* Spicetify text theme essentials */}}

{{- if and (eq .chezmoi.os "darwin") .personal (not .headless) }}
[".config/spicetify/Themes/text/README.md"]
type = "file"
url = "https://raw.githubusercontent.com/spicetify/spicetify-themes/master/text/README.md"
refreshPeriod = "168h"

[".config/spicetify/Themes/text/user.css"]
type = "file"
url = "https://raw.githubusercontent.com/spicetify/spicetify-themes/master/text/user.css"
refreshPeriod = "168h"

{{- range .spicetify.extensions }}
[".config/spicetify/Extensions/{{ .filename }}"]
type = "file"
url = "{{ .url }}"
refreshPeriod = "168h"

{{- end }}

[".config/spicetify/CustomApps/marketplace"]
type = "archive"
url = "https://github.com/spicetify/marketplace/releases/latest/download/marketplace.zip"
exact = true
stripComponents = 1
refreshPeriod = "168h"

[".config/spicetify/CustomApps/stats"]
type = "archive"
url = "https://github.com/harbassan/spicetify-apps/releases/download/stats-v1.1.3/spicetify-stats.release.zip"
exact = true
stripComponents = 1
refreshPeriod = "168h"

[".config/spicetify/CustomApps/library"]
type = "archive"
url = "https://github.com/harbassan/spicetify-apps/releases/download/library-v1.1.1/spicetify-library.release.zip"
exact = true
stripComponents = 1
refreshPeriod = "168h"
{{- end }}

{{- if .personal }}

{{/* Externals are applied before ~/.ssh and the tool/SSH after-hooks. */}}
{{- if eq (includeTemplate ".chezmoitemplates/private-harness-ready.tmpl" .) "false" }}
{{- warnf "Private Gitea configs deferred until Bitwarden SSH is provisioned. After SSH refresh succeeds, run chezmoi apply again." }}
{{- else }}
{{/* agent harness configs */}}
[".claude"]
type = "git-repo"
url = "ssh://git@gitea.lab.brendans.cloud/xbxd/claude-config.git"
refreshPeriod = "168h"
exclude = [
  "*/.editorconfig",
  "*/.gitattributes",
  "*/.github",
  "*/.gitignore",
]
[".claude".pull]
args = ["--autostash", "--rebase"]

[".pi"]
type = "git-repo"
url = "ssh://git@gitea.lab.brendans.cloud/xbxd/pi-config.git"
refreshPeriod = "168h"
exclude = [
  "*/.editorconfig",
  "*/.gitattributes",
  "*/.github",
  "*/.gitignore",
]
[".pi".pull]
args = ["--autostash", "--rebase"]
{{- end }}
{{- end }}

