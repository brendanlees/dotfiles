#!/usr/bin/env bash
# Keep this integration local to SketchyBar, independent of showy-quota's other UIs.
source "${CONFIG_DIR:-$HOME/.config/sketchybar}/colors.sh"
export SHOWY_QUOTA_NO_CONFIG=1
# Initial mode; the popup switch remembers its choice in ~/.cache/sketchybar/quota-mode.
export SKETCHYBAR_QUOTA_MODE=remaining
export SHOWY_QUOTA_PNG_BAR_W=40
# Remaining-mode width: window (20+4), bar (40), percentage (4+60), and 4px gap.
# Used mode shrinks the percentage label and column together.
export SHOWY_QUOTA_SKETCHYBAR_BAR_WIDTH=132
# Avoid colliding with a manually started CodexBar dashboard on its default port.
export SHOWY_QUOTA_CODEXBAR_SERVE_URL=http://127.0.0.1:18473
export SHOWY_QUOTA_REFRESH_SECONDS=120
