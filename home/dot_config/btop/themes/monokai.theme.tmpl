# Theme generated from .chezmoidata/themes.yml
# Active theme: {{ .theme }}
{{- $p := (index .themes .theme).palette }}

theme[main_bg]="{{ $p.bg }}"
theme[main_fg]="{{ $p.fg }}"

theme[title]="{{ $p.fg }}"

theme[hi_fg]="{{ $p.orange }}"

theme[selected_bg]="{{ $p.surface }}"
theme[selected_fg]="{{ $p.info }}"

theme[proc_misc]="{{ $p.info }}"

theme[cpu_box]="{{ $p.info_alt }}"
theme[mem_box]="{{ $p.info_alt }}"
theme[net_box]="{{ $p.info_alt }}"
theme[proc_box]="{{ $p.info_alt }}"
theme[div_line]="{{ $p.info_alt }}"

theme[temp_start]="{{ $p.success }}"
theme[temp_mid]="{{ $p.warn }}"
theme[temp_end]="{{ $p.error }}"

theme[cpu_start]="{{ $p.success }}"
