[settings]
{{ if eq .chezmoi.os "linux" -}}
# Prefer static Linux artifacts so managed tools run on older Ubuntu hosts.
libc = "musl"
{{ end -}}
{{ if and (hasKey . "github_token") .github_token -}}
github.credential_command = 'chezmoi execute-template "{{ "{{ .github_token }}" }}"'
{{ end -}}

[tools]
uv = "latest"
neovim = "latest"
starship = "latest"
zoxide = "latest"
lazygit = "latest"
lazydocker = "latest"
eza = "latest"
carapace = "latest"
ripgrep = "latest"
"github:mr-karan/doggo" = "latest"
glow = "latest"
gum = "latest"
fd = "latest"
fzf = "latest"
atuin = "latest"
# Skip Rust on Alpine because installing it crashes the Home Assistant SSH container.
{{ if not (and (eq .chezmoi.os "linux") (eq (dig "osRelease" "id" "" .chezmoi) "alpine")) -}}
rust = "latest"
{{ end -}}
chezmoi = "latest"
hunk = "latest"
{{ if or .personal .homelab -}}
infisical = "latest"
{{ end -}}
{{ if ne .chezmoi.os "windows" -}}
"github:Giammarco-Ferranti/deja" = "latest"
# Minimum toolchain for the pinned Herdr Plus source build.
go = "1.26.2"
tmux = "latest"
{{ end -}}
jq = "latest"
gh = "latest"
duf = "latest"
dua = "latest"
gdu = "latest"
"github:schollz/croc" = "latest"
fastfetch = "latest"
yazi = "latest"
{{ if eq .chezmoi.os "linux" -}}
"github:aristocratos/btop" = "latest"
{{ end -}}
"github:joshmedeski/sesh" = "latest"
bat = "latest"
delta = "latest"
{{ if eq .chezmoi.os "darwin" -}}
node = "lts"
python = "latest"
{{ end -}}
{{ if .personal -}}
pi = "latest" 
{{ end -}}
