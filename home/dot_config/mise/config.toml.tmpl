[settings]
{{ if eq .chezmoi.os "linux" -}}
# Prefer static Linux artifacts so managed tools run on older Ubuntu hosts.
libc = "musl"
{{ end -}}
{{ if and (hasKey . "github_token") .github_token -}}
github.credential_command = 'chezmoi execute-template "{{ "{{ .github_token }}" }}"'
{{ end -}}

[tools]
uv = "latest"
neovim = "latest"
starship = "latest"
zoxide = "latest"
lazygit = "latest"
lazydocker = "latest"
eza = "latest"
carapace = "latest"
ripgrep = "latest"
"github:mr-karan/doggo" = "latest"
glow = "latest"
gum = "latest"
fd = "latest"
fzf = "latest"
atuin = "latest"
# Skip Rust on Alpine because installing it crashes the Home Assistant SSH container.
{{ if not (and (eq .chezmoi.os "linux") (eq (dig "osRelease" "id" "" .chezmoi) "alpine")) -}}
rust = "latest"
{{ end -}}
chezmoi = "latest"
hunk = "latest"
{{ if or .personal .homelab -}}
infisical = "latest"
{{ end -}}
{{ if ne .chezmoi.os "windows" -}}
# Toolchain for the pinned Herdr Plus source build.
go = "1.26.10"
tmux = "latest"
{{ end -}}
jq = "latest"
gh = "latest"
duf = "latest"
dua = "latest"
gdu = "latest"
"github:schollz/croc" = "latest"
fastfetch = "latest"
yazi = "latest"
{{ if eq .chezmoi.os "linux" -}}
"github:aristocratos/btop" = "latest"
{{ end -}}
"github:joshmedeski/sesh" = "latest"
bat = "latest"
delta = "latest"
{{ if eq .chezmoi.os "darwin" -}}
node = "lts"
python = "latest"
{{ end -}}
{{ if .personal -}}
{{ if eq .chezmoi.os "darwin" -}}
"npm:obsidian-headless" = { version = "0.0.14", allow_builds = ["better-sqlite3"] }
# Excalidraw canvas CLI for the private excalidraw agent skill. Its Mermaid
# dependencies pin two releases published without provenance, each reviewed
# against its upstream tag and publisher: mermaid 10.9.4 (a hand-published
# security backport) and langium 3.3.1 (from a run of releases without it).
"npm:mcp-excalidraw-server" = { version = "2.1.2", trust_policy_excludes = ["mermaid@10.9.4", "langium@3.3.1"] }
{{ end -}}
actionlint = "latest"
pi = "latest"
shellcheck = "latest"
shfmt = "latest"
# Aqua cannot list gitea.com releases; the Forgejo backend speaks the Gitea API.
"forgejo:gitea/tea" = { version = "latest", api_url = "https://gitea.com/api/v1" }
taplo = "latest"
yamllint = "latest"
yq = "latest"
{{ end -}}
