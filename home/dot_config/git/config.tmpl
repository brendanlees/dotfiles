[user]
{{- if and .personal (lookPath "bw") }}
  name  = {{ .bw_github.name }}
  email = {{ .bw_github.email }}
{{- else if and (not .personal) .work }}
  name  = {{ .git_name }}
  email = {{ .git_email }}
{{- else }}
  name  = {{ .chezmoi.username }}
  email = {{ .chezmoi.username }}@{{ .chezmoi.hostname }}
{{- end }}

[init]
  defaultBranch = main

[pull]
  rebase = true

[push]
  autoSetupRemote = true

[core]
  pager = hunk pager

[diff]
  tool = hunk

[difftool]
  prompt = false

[difftool "hunk"]
  cmd = hunk difftool "$LOCAL" "$REMOTE" "$MERGED"
{{- if .personal }}

# In these globs * stops at /, so **/ and /** are needed to match ssh://, scp-style and https remotes.
[includeIf "hasconfig:remote.*.url:**/*git.lab.brendans.cloud*/**"]
  path = ~/.config/git/forgejo

[includeIf "hasconfig:remote.*.url:**/*github.com*/**"]
  path = ~/.config/git/github
{{- end }}
{{- if eq .chezmoi.os "darwin" }}

[credential]
  helper = osxkeychain
{{- else if eq .chezmoi.os "windows" }}

[credential]
  helper = manager
{{- end }}
{{- if and (ne .chezmoi.os "windows") (lookPath "gh") }}

# Use the gh login for GitHub over HTTPS. The empty helper drops earlier ones,
# so git never falls back to a keychain entry or a password prompt. Plain gh,
# not an absolute path: mise installs it under a versioned directory.
[credential "https://github.com"]
  helper =
  helper = !gh auth git-credential
{{- end }}
