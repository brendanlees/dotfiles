[[session]]
name = "homelab"
path = "~/{{ .code_dir }}/homelab/ansible/homelab"
startup_command = "ansible-playbook update-servers.yml"

[[session]]
name = "pi-config"
path = "~/.pi"
startup_command = "pi"

[[session]]
name = "claude-config"
path = "~/.claude"
startup_command = "claude"

[[session]]
name = "hermes-config"
path = "~/{{ .code_dir }}/homelab/local-stdy01-docker"

[[session]]
name = "hermes-folder"
path = "~/Agents/hermes/"

[[wildcard]]
pattern = "~/{{ .code_dir }}/*"

