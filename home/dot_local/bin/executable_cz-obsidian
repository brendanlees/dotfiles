#!/usr/bin/env python3
"""Prepare Obsidian Sync interactively, or guard an opted-in background service."""

import argparse
import json
import os
from pathlib import Path
import socket
import subprocess
import sys


LABEL = "com.brendan.obsidian-headless"
SETTINGS = {
    "file_types": "--file-types",
    "configs": "--configs",
    "excluded_folders": "--excluded-folders",
    "conflict_strategy": "--conflict-strategy",
}


def preferences_path():
    return Path.home() / ".config/obsidian-headless/setup.json"


def metadata(item):
    # Read the item's notes only, never its login password, TOTP or hidden fields.
    result = subprocess.run(
        ["bw", "--nointeraction", "get", "notes", item],
        capture_output=True, text=True,
    )
    if result.returncode:
        raise RuntimeError(
            'Cannot read Bitwarden metadata. Check the item reference and unlock '
            'the CLI with: export BW_SESSION="$(bw unlock --raw)"'
        )
    try:
        return json.loads(result.stdout)
    except json.JSONDecodeError:
        raise ValueError("The Bitwarden item's notes must contain a JSON object.") from None


def validate_metadata(data):
    if not isinstance(data, dict) or set(data) - {"email", "vault", "sync"}:
        raise ValueError("Metadata accepts only email, vault and optional sync settings.")
    for field in ("email", "vault"):
        value = data.get(field)
        if not isinstance(value, str) or not value.strip() or "\n" in value or "\r" in value:
            raise ValueError(f"Metadata requires a non-empty {field}.")
    settings = data.get("sync", {})
    if not isinstance(settings, dict) or set(settings) - SETTINGS.keys():
        raise ValueError("Unsupported sync settings; see cz-obsidian setup --help.")
    args = []
    for name, value in settings.items():
        if name == "conflict_strategy":
            if value not in ("merge", "conflict"):
                raise ValueError("conflict_strategy must be merge or conflict.")
        else:
            if not isinstance(value, list) or any(
                not isinstance(item, str) or not item or any(c in item for c in ",\n\r")
                for item in value
            ):
                raise ValueError(f"{name} must be a list of non-empty strings without commas.")
            value = ",".join(value)
        args.extend([SETTINGS[name], value])
    return args


def setup(args):
    if not sys.stdin.isatty():
        raise RuntimeError("Run setup in an interactive terminal for passwords and MFA.")
    item = args.item
    saved = preferences_path()
    if item is None and saved.exists():
        item = json.loads(saved.read_text()).get("bitwarden_item")
    if item is None:
        item = input("Bitwarden metadata item ID/name (blank for manual setup): ").strip()
    data = metadata(item) if item else {
        "email": input("Obsidian account email: ").strip(),
        "vault": input("Remote vault ID/name: ").strip(),
    }
    settings = validate_metadata(data)
    vault = args.path.expanduser().resolve()
    print(f"Account: {data['email']}\nRemote vault: {data['vault']}\nLocal vault: {vault}")
    print("Back up existing notes first. Setup links the vault but does not start syncing.")
    if input("Continue with interactive setup? [y/N] ").strip().lower() not in ("y", "yes"):
        return
    active = subprocess.run(
        ["launchctl", "print", f"gui/{os.getuid()}/{LABEL}"],
        stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL,
    )
    if active.returncode == 0:
        raise RuntimeError(
            "Stop the headless service before reconfiguring: set "
            "obsidian_headless.enabled to false and run chezmoi apply."
        )
    # Inherit the terminal: Obsidian itself owns password, MFA and encryption prompts.
    subprocess.run(["ob", "login", "--email", data["email"]], check=True)
    subprocess.run(
        ["ob", "sync-setup", "--vault", data["vault"], "--path", str(vault),
         "--device-name", socket.gethostname()],
        check=True,
    )
    if settings:
        subprocess.run(["ob", "sync-config", "--path", str(vault), *settings], check=True)
    saved.parent.mkdir(parents=True, exist_ok=True, mode=0o700)
    saved.write_text(json.dumps({"bitwarden_item": item}) + "\n")
    print(
        "Setup complete; syncing has not started. Disable desktop Obsidian Sync "
        "on this Mac before enabling the headless service.\n"
        "Add or update this section in chezmoi's home/.chezmoidata/local.yml, "
        "preserving any other settings, then run chezmoi apply:\n\n"
        "obsidian_headless:\n  enabled: true\n  vault_path: " + json.dumps(str(vault))
    )


def check_ready(vault):
    if not vault.is_dir():
        raise RuntimeError("Configured Obsidian vault is missing; run cz-obsidian setup.")
    # sync-status --json only validates local configuration, not authentication.
    token = Path.home() / ".obsidian-headless/auth_token"
    if not os.environ.get("OBSIDIAN_AUTH_TOKEN") and (
        not token.is_file() or token.stat().st_size == 0
    ):
        raise RuntimeError("No Obsidian login token; run ob login interactively.")
    result = subprocess.run(
        ["ob", "sync-status", "--path", str(vault), "--json"],
        capture_output=True, text=True,
    )
    if result.returncode:
        raise RuntimeError("Vault is not ready for Sync; run cz-obsidian setup.")
    config = json.loads(result.stdout)
    config_dir = config.get("configDir", ".obsidian")
    if not isinstance(config_dir, str) or not config_dir or Path(config_dir).name != config_dir or config_dir in (".", ".."):
        raise ValueError("Invalid Obsidian config directory.")
    plugins_file = vault / config_dir / "core-plugins.json"
    if plugins_file.exists():
        plugins = json.loads(plugins_file.read_text())
        if not isinstance(plugins, (list, dict)):
            raise ValueError("Cannot determine whether desktop Obsidian Sync is disabled.")
        sync_enabled = "sync" in plugins if isinstance(plugins, list) else plugins.get("sync")
        if sync_enabled:
            raise RuntimeError("Disable desktop Obsidian Sync before starting headless Sync.")


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    commands = parser.add_subparsers(dest="command", required=True)
    guide = commands.add_parser(
        "setup", help="Read optional Bitwarden metadata and configure Sync interactively",
        description="Passwords, MFA and the encryption password are always entered in Obsidian's prompts.",
        epilog='Bitwarden item notes example: {"email":"you@example.com","vault":"remote-vault-id",'
               '"sync":{"configs":[],"excluded_folders":[".trash"]}}. '
               "Optional sync keys: file_types, configs, excluded_folders, conflict_strategy. "
               "Only the item reference is remembered locally. Use --item '' for manual metadata entry.",
    )
    guide.add_argument("--item", help="Bitwarden item ID/name; defaults to the last successful reference")
    for command in (guide, commands.add_parser("check"), commands.add_parser("run")):
        command.add_argument("--path", type=Path, default=Path.home() / "Notes/Obsidian/PKM")
    args = parser.parse_args()
    os.umask(0o077)
    try:
        if args.command == "setup":
            setup(args)
        else:
            vault = args.path.expanduser().resolve()
            check_ready(vault)
            if args.command == "run":
                os.execvp("ob", ["ob", "sync", "--continuous", "--path", str(vault)])
    except (OSError, ValueError, RuntimeError, subprocess.CalledProcessError) as error:
        print(f"cz-obsidian: {error}", file=sys.stderr)
        return 1
    except (EOFError, KeyboardInterrupt):
        print("\nSetup cancelled.", file=sys.stderr)
        return 1
    return 0


if __name__ == "__main__":
    sys.exit(main())
